# Copy to .env for local development. On Render, set these in the dashboard instead.
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=you@example.com

# --- Email codes (OTP) ---
# Render's FREE plan blocks SMTP ports, so use an HTTPS email API.
# Option A (recommended, free, works without owning a domain): Brevo
#   1. Create a free Brevo account -> Senders -> add & verify your sender email
#   2. SMTP & API -> API keys -> create a key
BREVO_API_KEY=  
MAIL_FROM=JEENIUS <your-verified-sender@example.com>
# Option B: Resend (only delivers to anyone once you verify a domain)
#   SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASSWORD=re_xxx  MAIL_FROM=JEENIUS <noreply@yourdomain.com>
# Local testing only: show the code on screen instead of emailing it.
# DEV_SHOW_OTP=1

# --- AI keys ---
# Chat failover order: GEMINI_API_KEY -> _2 -> _3 -> Groq gpt-oss-120b -> OpenRouter Gemma 4 31B -> local fallback
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Groq is used for chat fallback AND for animation observations (different params, see server.py)
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the OpenRouter model (default google/gemma-4-31b-it:free)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
